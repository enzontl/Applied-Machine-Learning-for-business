# Copier ce fichier en `.env` et remplir les valeurs
# `.env` est ignoré par git, pas `.env.example`

# Cache OSMnx (optionnel, pour éviter de re-télécharger les graphes)
OSMNX_CACHE_FOLDER=./cache

# Token API INSEE (optionnel, pour automatiser les téléchargements)
# INSEE_API_KEY=

# Niveau de log par défaut
LOG_LEVEL=INFO
